generator client {
  provider = "prisma-client-js"
  // engineType = "binary"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

/* ------------------- enums ------------------- */
enum Role {
  patient
  doctor
  nurse
  pharmacist
  admin
}

/* ------------------- core models ------------------- */
model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  first_name      String?
  last_name       String?
  date_of_birth   String?
  gender          String?
  national_id     String?
  license_number  String?
  blood_type      String?
  email           String    @unique
  password        String?
  role            Role      @default(patient)
  avatarUrl       String?    @default("https://res.cloudinary.com/dc5khnuiu/image/upload/v1752627019/uxokaq0djttd7gsslwj9.png")
  phone_number    String?   @default("xxxx-xxx-xxxx")
  emergency_contact String? @default("xxxx-xxx-xxxx")
  department      Department? @relation(fields: [department_id], references: [id])
  department_id   String?    @db.ObjectId
  date_hired      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // relations from the messaging/feature set
  sentMessages    Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")
  forms           Form[]    @relation("FormOwner")
  conversations Conversation[] @relation("ConversationPatient")

  // other existing relations
  cart            Cart[]
  reviews         Review[]
  address         String?  //ShippingAddress[]
  post            Post[]
  notification    Notification[]
  appointments    Appointment[] @relation("PatientAppointment")
  admissions      Admission[]   @relation("PatientAdmission")
  staffAppointments Appointment[] @relation("StaffAppointment")
  staffAdmissions   Admission[]   @relation("StaffAdmission")
}

/* ------------------- form / conversation / message ------------------- */
model Form {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  ownerId       String        @db.ObjectId
  owner         User          @relation("FormOwner", fields: [ownerId], references: [id])
  fields        Json?         // free‑form data
  conversations Conversation[] @relation("FormConversations")
  appointments Appointment[] @relation("Appointmentforms")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}


model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  formId    String   @db.ObjectId
  form      Form     @relation("FormConversations", fields: [formId], references: [id])
  patientId String   @db.ObjectId
  patient   User     @relation("ConversationPatient", fields: [patientId], references: [id])
  messages  Message[] @relation("ConversationMessages")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  text          String
  senderId      String    @db.ObjectId
  sender        User      @relation("Sender", fields: [senderId], references: [id])
  receiverId    String    @db.ObjectId
  receiver      User      @relation("Receiver", fields: [receiverId], references: [id])
  conversationId String   @db.ObjectId
  conversation   Conversation @relation("ConversationMessages", fields: [conversationId], references: [id])
  sentAt        DateTime  @default(now())
  isQuestion    Boolean   @default(false)
  isAnswer      Boolean   @default(false)
}

/* ------------------- other existing models ------------------- */
model Post {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  contentUrl  String?
  authorId    String   @db.ObjectId
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  description String?
  staffs    User[]
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  description      String?
  categoryId       String        @db.ObjectId
  category         Category      @relation(fields: [categoryId], references: [id])
  activeIngredients String[]
  scarce           Boolean?
  for              String[]      // e.g., "oncology", "hiv"
  brand            String?
  price            Float
  stock            Stock[]
  min_stock_level  Float
  reviews          Review[]
  cartItems        CartItem[]
  Featured         FeaturedProduct?
  images           String[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Stock {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  productId    String   @unique @db.ObjectId
  product      Product  @relation(fields: [productId], references: [id])
  addedQuantity Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  user      User       @relation(fields: [userId], references: [id])
  products  CartItem[]
  total     Float
  payment   Payment?
  status    String     @default("pending")
  refund    Refund?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  departmenr_id String      @db.ObjectId
  department   Department  @relation(fields: [departmenr_id], references: [id])
  admissions   Admission[]
  bed_space    Int
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Appointment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  visit_date    DateTime
  visit_status  String   @default("Scheduled")
  patient_id    String   @db.ObjectId
  patient       User     @relation("PatientAppointment", fields: [patient_id], references: [id])
  case          String?
  questions     String[]
  remarks       String[]
  medical_staff_id String @db.ObjectId
  medical_staff   User   @relation("StaffAppointment", fields: [medical_staff_id], references: [id])

  // 👇 NEW FIELDS 👇
  scan_images   String[] // stores URLs or paths to scan images
  payment_status String @default("unpaid") // e.g., "paid", "unpaid", "refunded"
  admission_id  String? @db.ObjectId // optional link to an Admission record
  admission    Admission? @relation("AppointmentAdmission", fields: [admission_id], references: [id])
  form_id String? @db.ObjectId // optional, if you want a direct reference
  form      Form?     @relation("Appointmentforms", fields: [form_id], references: [id])
  

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Admission {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  admission_date DateTime
  discharge_date DateTime
  room_id       String   @db.ObjectId
  room          Room     @relation(fields: [room_id], references: [id])
  patient_id    String   @db.ObjectId
  patient       User     @relation("PatientAdmission", fields: [patient_id], references: [id])
  medical_staff_id String @db.ObjectId
  medical_staff   User   @relation("StaffAdmission", fields: [medical_staff_id], references: [id])
  appointments Appointment[] @relation("AppointmentAdmission")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @unique @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id])
  method    String   // could become an enum later
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique
  discount  Float?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

